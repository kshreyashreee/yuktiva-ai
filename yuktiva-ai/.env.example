# ============================================================
#  Yuktiva AI — Environment Configuration
#  Copy this file to .env and fill in your values
# ============================================================

# ── REQUIRED ─────────────────────────────────────────────────
# FREE key from: https://console.groq.com/
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ── SERVER ───────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# JWT secret — change this in production (any long random string)
JWT_SECRET=yuktiva-ai-super-secret-jwt-key-change-in-production-2025

# URL where your React client runs (for CORS)
CLIENT_URL=http://localhost:5173

# ── OPTIONAL: Social Media API Keys ──────────────────────────
# These are needed for actual OAuth publishing 
# INSTAGRAM_CLIENT_ID=
# INSTAGRAM_CLIENT_SECRET=
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
